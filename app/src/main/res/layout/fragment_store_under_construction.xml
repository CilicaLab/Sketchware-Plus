<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_under_construction"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Blocks &amp; Components Store"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Construction Graphic / Illustration -->
            <ImageView
                android:id="@+id/img_under_construction"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="Store Under Construction"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_store_under_construction" />

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="false"
                android:text="WORK IN PROGRESS"
                android:textColor="?attr/colorPrimary"
                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:chipIcon="@drawable/ic_mtrl_deployed_code"
                app:chipIconTint="?attr/colorPrimary"
                app:strokeColor="?attr/colorOutlineVariant" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_title_under_construction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Store Feature Coming Soon "
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_desc_under_construction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:maxWidth="320dp"
                android:text="We're actively building the Store so you can browse, download, and share custom block and component packs. Stay tuned for future releases!"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Subtle Hint for Dev Toggle -->
            <TextView
                android:id="@+id/tv_dev_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="💡"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOutline" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
